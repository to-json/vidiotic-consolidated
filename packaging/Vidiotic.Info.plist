<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Vidiotic</string>
	<key>CFBundleDisplayName</key>
	<string>Vidiotic</string>
	<key>CFBundleIdentifier</key>
	<string>com.vidiotic.player</string>
	<key>CFBundleExecutable</key>
	<string>vidiotic</string>
	<key>CFBundleIconFile</key>
	<string>Vidiotic</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

	<!-- TCC. These strings are what the system shows in its permission
	     prompts; without them the process is killed the moment it touches
	     the device rather than being asked about. -->
	<key>NSCameraUsageDescription</key>
	<string>Vidiotic uses cameras as live video sources you can cue and mix.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Vidiotic listens to an audio input to drive beat detection and audio-reactive shaders.</string>
	<key>NSInputMonitoringUsageDescription</key>
	<string>Vidiotic reads MIDI controllers and gamepads you have mapped to performance controls.</string>

	<!-- Double-clicking a project opens it in the player. Prep claims the
	     same type at Alternate rank, so it shows up under "Open With". -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Vidiotic Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.vidiotic.project</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.vidiotic.project</string>
			<key>UTTypeDescription</key>
			<string>Vidiotic Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>viproj</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.vidiotic.controlmap</string>
			<key>UTTypeDescription</key>
			<string>Vidiotic Control Map</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vmap</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
